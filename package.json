{
  "name": "traceweft",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "kfcLJH-HUB",
  "description": "A local AI session journal for Codex, Claude Code and Doubao.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build && esbuild electron/main.ts electron/preload.ts electron/doubao-preload.ts electron/deepseek-preload.ts --bundle --platform=node --outdir=dist-electron --external:electron --format=cjs --sourcemap",
    "start": "electron .",
    "package:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "package:mac:dir": "npm run build && electron-builder --mac --arm64 --dir --publish never",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:win:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:release",
    "test:watch": "vitest",
    "test:release": "node --test scripts/release-checks.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.4",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.511.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "cross-env": "^7.0.3",
    "typescript": "^5.8.3",
    "vitest": "5.0.1",
    "electron-builder": "^26.0.12",
    "electron": "44.4.3"
  },
  "build": {
    "appId": "com.summary.ai-session-summary",
    "productName": "Traceweft",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Traceweft-${version}-${arch}.${ext}",
      "identity": "-",
      "notarize": false
    },
    "dmg": {
      "title": "Traceweft ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "Traceweft-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Traceweft-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
